{
  "_comment_model": "对照实验：用 test1 数据微调 quanformer 基线，验证能否追平 v1_fdr",
  "model": "quanformer",
  "backbone": "resnet50",
  "dilation": false,
  "position_embedding": "sine",
  "enc_layers": 1,
  "dec_layers": 1,
  "num_queries": 3,
  "hidden_dim": 256,
  "nheads": 8,
  "dim_feedforward": 2048,
  "dropout": 0.1,
  "pre_norm": false,
  "masks": false,
  "aux_loss": true,
  "iou_type": "ciou",
  "set_cost_class": 1,
  "set_cost_bbox": 5,
  "set_cost_iou": 2,
  "mask_loss_coef": 1,
  "dice_loss_coef": 1,
  "bbox_loss_coef": 5,
  "iou_loss_coef": 2,
  "eos_coef": 0.1,
  "dataset_file": "coco",
  "coco_path": "../data/coco/test1_ft",
  "remove_difficult": false,
  "start_epoch": 0,
  "frozen_weights": null,
  "coco_panoptic_path": null,
  "eval": false,
