  "resume": "checkpoint/quanformer.pth",
  "reset_optimizer": true,
  "output_dir": "../output/train/quanformer_test1_ft",
  "device": "auto",
  "lr": 1e-05,
  "lr_backbone": 1e-06,
  "batch_size": 8,
  "weight_decay": 0.0001,
  "epochs": 20,
  "lr_drop": 100,
  "clip_max_norm": 0.1,
  "seed": 42,
  "num_workers": 4,
  "amp": true,
  "tf32": true,
  "cudnn_benchmark": true,
  "world_size": 1,
  "dist_url": "env://"
}
