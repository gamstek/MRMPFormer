{
  "_comment_model": "MRMPFormer v1 多源联合训练：P0-1(matcher CIoU修复) + P0-2(fdr_loss_coef 2.0→1.0) + P2-8(多源合并数据)",
  "model": "mrmpformer_v1",
  "backbone": "resnet50",
  "dilation": false,
  "position_embedding": "sine",
  "enc_layers": 1,
  "dec_layers": 3,
  "num_queries": 3,
  "hidden_dim": 256,
  "nheads": 8,
  "dim_feedforward": 2048,
  "dropout": 0.1,
  "pre_norm": false,
  "masks": false,
  "aux_loss": true,
  "iou_type": "ciou",
  "set_cost_class": 1,
  "set_cost_bbox": 5,
  "set_cost_iou": 2,
  "mask_loss_coef": 1,
  "dice_loss_coef": 1,
  "bbox_loss_coef": 5,
  "iou_loss_coef": 2,
  "eos_coef": 0.1,

  "_comment_fdr": "=== FDR 参数（与 v1_fdr 基线一致，仅 fdr_loss_coef 降半）===",
  "num_fdr_bins": 33,
  "fdr_bin_power": 2.0,
  "fdr_bin_values": null,
  "fdr_scale_mode": "initial_box_width",
  "fdr_layer_weights": [0.5, 0.7, 1.0],
  "_comment_fdr_loss_coef": "P0-2：2.0→1.0（有效 8.8→4.4，释放分类/召回学习空间）",
  "fdr_loss_coef": 1.0,
  "fdr_min_width": 1e-4,
  "detach_boundary_feedback": false,

  "_comment_cls": "=== 分类：Focal Loss ===",
  "classification_loss": "focal",
  "focal_alpha": 0.25,
  "focal_gamma": 2.0,
  "cls_loss_coef": 1.0,
  "aux_class_loss": true,
  "aux_class_loss_coef": 1.0,

  "_comment_dyn_l1": "=== 动态加权 L1 ===",
  "dynamic_l1_enabled": true,
  "dynamic_l1_eps": 1e-6,
  "dynamic_l1_lambda_w": 1.0,
  "dynamic_l1_lambda_h": 1.0,
  "center_weight_clip": null,
  "normalize_dynamic_weights": false,

  "_comment_pw_ciou": "=== PW-CIoU：bar_w 来自 multisrc 合并训练集实测（13929 峰，与 traindata3 0.1808 基本一致）===",
  "pw_ciou_enabled": true,
  "pw_ciou_weight_mode": "ratio",
  "pw_ciou_eps": 1e-6,
  "pw_ciou_weight_clip": null,
  "pw_ciou_mean_width": 0.1809,

  "recall_loss_enabled": false,

  "_comment_dataset": "=== 数据：multisrc = traindata3(98) + shiyaoyuan_1 + traindata2(5) + test1(7)；val = QC/QC5 + shiyaoyuan_2 + test1-7/8 + 空白1-2/3 ===",
  "dataset_file": "coco",
  "coco_path": "../data/coco/multisrc",
  "remove_difficult": false,
  "device": "cuda",
  "seed": 42,
  "num_workers": 4,
  "amp": true,
  "tf32": true,
  "cudnn_benchmark": true,
  "lr": 5e-5,
  "lr_backbone": 5e-6,
  "batch_size": 16,
  "weight_decay": 1e-4,
  "epochs": 30,
  "lr_drop": 20,
  "clip_max_norm": 0.1,
  "_comment_resume": "热启动自 v1_fdr checkpoint（同结构完整加载），reset_optimizer 重新适配多源约定与新损失权重",
  "resume": "../output/train/mrmpformer_v1_fdr/checkpoint.pth",
  "reset_optimizer": true,
  "start_epoch": 0,
  "frozen_weights": null,
  "coco_panoptic_path": null,
  "eval": false,
  "output_dir": "../output/train/mrmpformer_v1_multisrc"
}
